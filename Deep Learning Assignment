        "def evaluate_model(model, loader):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    actual = []\n",
        "    predicted = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for images, labels in loader:\n",
        "\n",
        "            images = images.to(device)\n",
        "\n",
        "            outputs = model(images)\n",
        "\n",
        "            predictions = outputs.argmax(dim=1)\n",
        "\n",
        "            actual.extend(labels.numpy())\n",
        "            predicted.extend(predictions.cpu().numpy())\n",
        "\n",
        "    print(\"Accuracy:\",\n",
        "          accuracy_score(actual, predicted))\n",
        "\n",
        "    print(\"Precision:\",\n",
        "          precision_score(\n",
        "              actual, predicted,\n",
        "              average=\"macro\",\n",
        "              zero_division=0\n",
        "          ))\n",
        "\n",
        "    print(\"Recall:\",\n",
        "          recall_score(\n",
        "              actual, predicted,\n",
        "              average=\"macro\",\n",
        "              zero_division=0\n",
        "          ))\n",
        "\n",
        "    print(\"F1 Score:\",\n",
        "          f1_score(\n",
        "              actual, predicted,\n",
        "              average=\"macro\",\n",
        "              zero_division=0\n",
        "          ))\n",
        "\n",
        "    print(\"\\nClassification Report:\")\n",
