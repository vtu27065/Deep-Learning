        "class TemporalModel(nn.Module):\n",
        "\n",
        "    def __init__(self, input_size=128,\n",
        "                 hidden_size=64,\n",
        "                 num_classes=3,\n",
        "                 model_type=\"LSTM\"):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        if model_type == \"RNN\":\n",
        "\n",
        "            self.rnn = nn.RNN(\n",
        "                input_size,\n",
        "                hidden_size,\n",
        "                batch_first=True\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            self.rnn = nn.LSTM(\n",
        "                input_size,\n",
        "                hidden_size,\n",
        "                batch_first=True\n",
        "            )\n",
        "\n",
        "        self.fc = nn.Linear(hidden_size, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "\n",
        "        output, _ = self.rnn(x)\n",
        "\n",
        "        output = output[:, -1, :]\n",
        "\n",
        "        return self.fc(output)"
