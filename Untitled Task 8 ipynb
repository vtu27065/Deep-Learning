        "# Step 1 — Import the required libraries\n",
        "\n",
        "# Code cell 3\n",
        "# Cell 3 of 26\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import TensorDataset, DataLoader\n",
        "\n",
        "print(\"PyTorch version:\", torch.__version__)\n",
        "\n",
        "# Step 2 — Select the device\n",
        "# Cell 4 of 26\n",
        "\n",
        "# Step 2 — Select the device\n",
        "\n",
        "# Code cell 5\n",
        "# Cell 5 of 26\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(\"Using device:\", device)\n",
        "\n",
        "# Step 3 — Create the time-series dataset\n",
        "# Cell 6 of 26\n",
        "\n",
        "# Step 3 — Create the time-series dataset\n",
        "# We create a sine wave as sample data. The model uses the previous 20 values to predict the next value.\n",
        "\n",
        "# Code cell 7\n",
        "# Cell 7 of 26\n",
        "\n",
        "np.random.seed(42)\n",
        "time = np.linspace(0, 100, 1200)\n",
        "series = np.sin(time).astype(np.float32)\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.plot(time[:250], series[:250])\n",
        "plt.title(\"Sample Time Series (Sine Wave)\")\n",
        "plt.xlabel(\"Time\")\n",
        "plt.ylabel(\"Value\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Step 4 — Prepare input sequences and targets\n",
        "# Cell 8 of 26\n",
        "\n",
        "# Step 4 — Prepare input sequences and targets\n",
        "\n",
        "# Code cell 9\n",
        "# Cell 9 of 26\n",
        "\n",
        "sequence_length = 20\n",
        "\n",
        "X, y = [], []\n",
        "for i in range(len(series) - sequence_length):\n",
        "    X.append(series[i:i + sequence_length])\n",
        "    y.append(series[i + sequence_length])\n",
        "\n",
        "X = np.array(X, dtype=np.float32).reshape(-1, sequence_length, 1)\n",
        "y = np.array(y, dtype=np.float32).reshape(-1, 1)\n",
        "\n",
        "# Use earlier data for training and later data for testing.\n",
        "split_index = int(0.8 * len(X))\n",
        "X_train, X_test = X[:split_index], X[split_index:]\n",
        "y_train, y_test = y[:split_index], y[split_index:]\n",
        "\n",
        "X_train = torch.tensor(X_train)\n",
        "y_train = torch.tensor(y_train)\n",
        "X_test = torch.tensor(X_test)\n",
        "y_test = torch.tensor(y_test)\n",
        "\n",
        "train_loader = DataLoader(\n",
        "    TensorDataset(X_train, y_train),\n",
        "    batch_size=32,\n",
        "    shuffle=True\n",
        ")\n",
        "\n",
        "print(\"Training sequences:\", len(X_train))\n",
        "print(\"Testing sequences:\", len(X_test))\n",
        "print(\"Input shape:\", X_train.shape)\n",
        "\n",
        "# Step 5 — Define the LSTM model\n",
        "# Cell 10 of 26\n",
        "\n",
        "# Step 5 — Define the LSTM model\n",
        "# The LSTM reads the input sequence and uses its final time-step output to predict one future value.\n",
        "\n",
        "# Code cell 11\n",
        "# Cell 11 of 26\n",
        "\n",
        "class LSTMPredictor(nn.Module):\n",
        "    def __init__(self, input_size=1, hidden_size=32, num_layers=1):\n",
        "        super().__init__()\n",
        "        self.lstm = nn.LSTM(\n",
        "            input_size=input_size,\n",
        "            hidden_size=hidden_size,\n",
        "            num_layers=num_layers,\n",
        "            batch_first=True\n",
        "        )\n",
        "        self.fc = nn.Linear(hidden_size, 1)\n",
        "\n",
        "    def forward(self, x):\n",
        "        output, _ = self.lstm(x)\n",
        "        last_output = output[:, -1, :]\n",
        "        prediction = self.fc(last_output)\n",
        "        return prediction\n",
        "\n",
        "model = LSTMPredictor().to(device)\n",
        "print(model)\n",
        "\n",
        "# Step 6 — Define loss function and optimizer\n",
        "# Cell 12 of 26\n",
        "\n",
        "# Step 6 — Define loss function and optimizer\n",
        "\n",
        "# Code cell 13\n",
        "# Cell 13 of 26\n",
        "\n",
        "criterion = nn.MSELoss()\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n",
        "\n",
        "# Step 7 — Set training parameters\n",
        "# Cell 14 of 26\n",
        "\n",
        "# Step 7 — Set training parameters\n",
        "\n",
        "# Code cell 15\n",
        "# Cell 15 of 26\n",
        "\n",
        "num_epochs = 20\n",
        "loss_history = []\n",
        "\n",
        "# Step 8 — Train the LSTM network\n",
        "# Cell 16 of 26\n",
        "\n",
        "# Step 8 — Train the LSTM network\n",
        "\n",
        "# Code cell 17\n",
        "# Cell 17 of 26\n",
        "\n",
        "for epoch in range(num_epochs):\n",
        "    model.train()\n",
        "    total_loss = 0.0\n",
        "\n",
        "    for inputs, targets in train_loader:\n",
        "        inputs = inputs.to(device)\n",
        "        targets = targets.to(device)\n",
        "\n",
        "        predictions = model(inputs)\n",
        "        loss = criterion(predictions, targets)\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "        total_loss += loss.item() * inputs.size(0)\n",
        "\n",
        "    epoch_loss = total_loss / len(train_loader.dataset)\n",
        "    loss_history.append(epoch_loss)\n",
        "\n",
        "    if (epoch + 1) % 5 == 0 or epoch == 0:\n",
        "        print(f\"Epoch [{epoch + 1}/{num_epochs}], Loss: {epoch_loss:.6f}\")\n",
        "\n",
        "# Step 9 — Plot the training loss\n",
        "# Cell 18 of 26\n",
        "\n",
        "# Step 9 — Plot the training loss\n",
        "\n",
        "# Code cell 19\n",
        "# Cell 19 of 26\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "plt.plot(range(1, num_epochs + 1), loss_history, marker=\"o\")\n",
        "plt.title(\"LSTM Training Loss\")\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Mean Squared Error\")\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Step 10 — Predict values for the test data\n",
        "# Cell 20 of 26\n",
        "\n",
        "# Step 10 — Predict values for the test data\n",
        "\n",
        "# Code cell 21\n",
        "# Cell 21 of 26\n",
        "\n",
        "model.eval()\n",
        "with torch.no_grad():\n",
        "    predictions = model(X_test.to(device)).cpu().numpy()\n",
        "\n",
        "actual_values = y_test.numpy()\n",
        "\n",
        "mse = np.mean((predictions - actual_values) ** 2)\n",
        "print(f\"Test Mean Squared Error: {mse:.6f}\")\n",
        "print(\"First 10 actual values:     \", np.round(actual_values[:10].flatten(), 3))\n",
        "print(\"First 10 predicted values:  \", np.round(predictions[:10].flatten(), 3))\n",
        "\n",
        "# Step 11 — Plot actual values versus predictions\n",
        "# Cell 22 of 26\n",
        "\n",
        "# Step 11 — Plot actual values versus predictions\n",
        "\n",
        "# Code cell 23\n",
        "# Cell 23 of 26\n",
        "\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.plot(actual_values[:200], label=\"Actual\")\n",
        "plt.plot(predictions[:200], label=\"Predicted\")\n",
        "plt.title(\"Actual vs Predicted Time-Series Values\")\n",
        "plt.xlabel(\"Test Time Step\")\n",
        "plt.ylabel(\"Value\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Step 12 — Predict the next value from a recent sequence\n",
        "# Cell 24 of 26\n",
        "\n",
        "# Step 12 — Predict the next value from a recent sequence\n",
        "\n",
        "# Code cell 25\n",
        "# Cell 25 of 26\n",
        "\n",
        "recent_sequence = torch.tensor(\n",
        "    series[-sequence_length:],\n",
        "    dtype=torch.float32\n",
        ").view(1, sequence_length, 1).to(device)\n",
        "\n",
        "model.eval()\n",
        "with torch.no_grad():\n",
        "    next_prediction = model(recent_sequence).item()\n",
        "\n",
        "print(\"Last observed value:\", float(series[-1]))\n",
        "print(\"Predicted next value:\", round(next_prediction, 4))"
      ]
    }
  ]
